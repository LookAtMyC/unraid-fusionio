<FILE Name="/usr/local/emhttp/plugins/fusionio/scripts/fusionio" Mode="0755">
<INLINE>
<![CDATA[
#!/usr/bin/php
<?php
// Command line tool for the Fusion-io plugin. Run without arguments for help.
require_once '/usr/local/emhttp/plugins/fusionio/include/fusionio.php';

function usage(): void {
    echo <<<TXT
Usage: fusionio <command> [card] [options]

  status                       list cards
  mount <card>                 mount a card under /mnt/disks/<name>
  unmount <card>               unmount a card
  automount <card> yes|no      mount at boot
  array <card> yes|no          show the card as a normal disk for the array/pools
  format <card> xfs|btrfs <name>   erase the card and create a filesystem
  boot                         apply all settings (run by the plugin at boot)

<card> is the serial number or the device name (e.g. fioa).

TXT;
}

function gb($b): string { return $b === null ? '-' : sprintf('%.1f GB', $b / 1e9); }

$cmd = $argv[1] ?? '';
$id  = $argv[2] ?? '';
try {
    switch ($cmd) {
        case 'status':
            foreach (fio_cards() as $c) {
                printf("%s  %-24s SN %-10s %8s  %s°C\n", $c['dev'], $c['product'], $c['serial'], gb($c['size']), $c['temp'] ?? '?');
                if ($c['array_mode']) {
                    printf("      array/pool mode: shown as /dev/%s\n", $c['sd'] ?? '?');
                } else {
                    printf("      filesystem: %s%s  mounted: %s  automount: %s\n",
                        $c['fs'] ?: 'none', $c['label'] ? " ({$c['label']})" : '',
                        $c['mountpoint'] ?? 'no', $c['automount'] ? 'yes' : 'no');
                }
            }
            break;
        case 'mount':
            echo 'mounted at ' . fio_mount($id) . "\n";
            break;
        case 'unmount':
            fio_unmount($id);
            echo "unmounted\n";
            break;
        case 'automount':
        case 'array':
            $v = $argv[3] ?? '';
            if (!in_array($v, ['yes', 'no'], true)) { usage(); exit(1); }
            $c = fio_card($id);
            if ($cmd === 'array') { $v === 'yes' ? fio_array_on($id) : fio_array_off($id); }
            fio_cfg_set($c['serial'], $cmd === 'array' ? 'ARRAY' : 'AUTOMOUNT', $v);
            echo "$cmd for {$c['serial']}: $v\n";
            break;
        case 'format':
            $c = fio_card($id);
            fwrite(STDOUT, "This erases ALL data on {$c['product']} (SN {$c['serial']}). Type the serial number to continue: ");
            if (trim(fgets(STDIN)) !== $c['serial']) { echo "cancelled\n"; exit(1); }
            fio_format($id, $argv[3] ?? '', $argv[4] ?? '');
            echo "formatted\n";
            break;
        case 'boot':
            fio_boot();
            break;
        default:
            usage();
            exit($cmd === '' ? 0 : 1);
    }
} catch (FioError $e) {
    fwrite(STDERR, 'fusionio: ' . $e->getMessage() . "\n");
    exit(1);
}
]]>
</INLINE>
</FILE>

<!-- Runs on install and on every boot. -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[

REPO="LookAtMyC/unraid-fusionio"
DIR="/boot/config/plugins/fusionio"
KV="$(uname -r)"
KO="$DIR/iomemory-vsl-$KV.ko"
URL="https://github.com/$REPO/releases/download/$KV/iomemory-vsl-$KV.ko"

say() { echo "fusionio: $*"; logger -t fusionio "$*"; }

mkdir -p "$DIR"
ln -sf /usr/local/emhttp/plugins/fusionio/scripts/fusionio /usr/local/sbin/fusionio

if ! lsmod | grep -q '^iomemory_vsl'; then
  if [ ! -f "$KO" ]; then
    say "downloading driver for kernel $KV"
    ok=""
    for try in 1 2 3 4 5; do
      if wget -q -T 15 -O "$KO.part" "$URL" && wget -q -T 15 -O "$KO.sha256" "$URL.sha256"; then
        ok=1; break
      fi
      sleep 5
    done
    if [ -z "$ok" ]; then
      rm -f "$KO.part" "$KO.sha256"
      say "no driver available for kernel $KV yet (or no network)."
      say "builds appear at https://github.com/$REPO/releases about a day after a new Unraid release."
      exit 0
    fi
    want="$(cut -d' ' -f1 "$KO.sha256")"
    got="$(sha256sum "$KO.part" | cut -d' ' -f1)"
    if [ "$want" != "$got" ]; then
      rm -f "$KO.part" "$KO.sha256"
      say "checksum mismatch for downloaded driver, not loading it"
      exit 0
    fi
    mv "$KO.part" "$KO"
    rm -f "$KO.sha256"
  fi

  # Drop drivers built for other kernels (left over from earlier Unraid versions).
  find "$DIR" -maxdepth 1 -name 'iomemory-vsl-*.ko' ! -name "iomemory-vsl-$KV.ko" -delete

  if ! insmod "$KO"; then
    say "loading the driver failed, see: dmesg | grep fio"
    exit 0
  fi
  # give the cards a moment to attach
  for i in $(seq 1 30); do ls /dev/fio[a-z] >/dev/null 2>&1 && break; sleep 1; done
  sleep 2
  say "driver loaded; cards: $(ls /dev/fio[a-z] 2>/dev/null | tr '\n' ' ')"
fi

# apply per-card settings (array/pool mode, auto mount)
/usr/local/sbin/fusionio boot
exit 0
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[

rm -rf /usr/local/emhttp/plugins/fusionio /usr/local/sbin/fusionio
rm -rf /boot/config/plugins/fusionio
echo "fusionio: plugin removed. The driver stays loaded until the next restart."
]]>
</INLINE>
</FILE>

</PLUGIN>
